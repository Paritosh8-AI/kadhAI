# Google Gemini API Key (Required for Vision & Multi-Modal Ingestion)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Required for Ultra-Fast Agentic Reasoning with Llama 3.3 70B)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: Langfuse for Observability & Tracing (Free Cloud Tier)
# Get your free project keys at: https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
